{
  "name": "radoje-lausevic-website-cms",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-19",
  "keep_vars": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "ratelimits": [{"name": "CONTACT_RATE_LIMITER", "namespace_id": "20261019", "simple": {"limit": 5, "period": 60}}]
  // Add send_email only AFTER the recipient and sending domain are verified.
  // ,"send_email": [{"name":"EMAIL"}]
}
