{
  "name": "radoje-lausevic-website-cms",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-19",
  "keep_vars": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
